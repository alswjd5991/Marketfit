# Supabase (필수 — 프로젝트 설정 > API에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # 서버 전용. 절대 NEXT_PUBLIC_ 접두어를 붙이거나 클라이언트에 노출하지 않는다.

# AI (선택 — 없으면 AI 답변을 비활성화)
GEMINI_API_KEY=
# 선택: 쉼표로 구분한 모델 전환 순서. 비우면 검증된 기본 후보를 사용한다.
GEMINI_MODELS=

# 공공데이터 (선택 — 5번 섹션 데이터 수집 단계에서 필요)
DATA_GO_KR_KEY=
# 선택: 한국관광공사 TourAPI 키(공공데이터포털). 있으면 AI 도우미가 전국 지자체 축제 일정을 직접 조회한다.
TOUR_API_KEY=
# 선택: 서울 열린데이터광장 인증키(공공데이터포털 키와 다름). 과거 행사 기간 수집 때 서울시 문화행사 정보(2021년 10월~)를 함께 모은다.
SEOUL_OPENAPI_KEY=

# 주간 행사 자동 업데이트(Vercel Cron → /api/cron/weekly-events) 인증용 임의 문자열(16자 이상).
# Vercel 프로젝트 환경변수에 넣으면 Cron 요청에 자동으로 Authorization: Bearer <값> 헤더가 붙는다.
# 같은 Vercel 환경변수에 SUPABASE_SERVICE_ROLE_KEY·TOUR_API_KEY도 있어야 실제로 저장된다.
CRON_SECRET=

# 합성 테스트 유저 30명 공통 로그인 비밀번호(npm run seed:synthetic). 직접 정해서 .env.local에만 넣는다.
SYNTHETIC_USER_PASSWORD=
